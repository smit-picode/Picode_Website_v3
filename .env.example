# Copy to .env.local and fill in as needed.

# Public URL of the site (used for metadata / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: contact form submissions are POSTed here as JSON.
# Leave empty to log submissions to the server console instead.
CONTACT_WEBHOOK_URL=

# Email notifications for new inquiries (contact brief + site assistant).
# Any SMTP provider works. Gmail/Google Workspace: smtp.gmail.com, port 465,
# SMTP_USER = the mailbox, SMTP_PASS = an App Password (not your normal password).
# Mailjet: in-v3.mailjet.com, port 587, SMTP_USER = API key, SMTP_PASS = secret key.
# Real values go in .env.local only — never in this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox; defaults to SMTP_USER
MAIL_FROM="Picode Website <no-reply@example.com>"
# Who gets notified (comma-separated)
INQUIRY_NOTIFY_TO=
# Optional: separate recipients for job applications (defaults to INQUIRY_NOTIFY_TO)
CAREERS_NOTIFY_TO=

# Admin console (/admin)
ADMIN_EMAIL=
# Generate with: npm run admin:hash -- "<password>"
ADMIN_PASSWORD_HASH=
# Random string, min. 32 chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Optional: where the JSON data store lives (defaults to ./data)
DATA_DIR=

# PostgreSQL connection string, e.g. postgresql://picode:<password>@localhost:5432/picode
# Required for careers (job posts, applications and resumes). Tables are created automatically.
DATABASE_URL=

# Jarvis website assistant (floating 3D bot). Optional — without a key Jarvis
# answers locally from the website's own pages, which it reads automatically.
GEMINI_API_KEY=
# Comma-separated model fallback ladder (first healthy one answers).
GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite
# Optional: where Jarvis reads the site from (defaults to this server).
JARVIS_CRAWL_ORIGIN=
